{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "iris-222-access-gate",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [
    { "pattern": "iris.suri.us.ci/*", "zone_name": "suri.us.ci" }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "222001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
